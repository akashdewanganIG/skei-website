# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Connection string used by Drizzle for both the public enquiry form and the
# SKEI Portal. Use the pooled connection string if your provider has one.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Public website ──────────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Server-only key used to verify enquiry form reCAPTCHA tokens.
RECAPTCHA_SECRET_KEY=

# ── Shared Google Sheet mirror (optional) ───────────────────────────────────
# Apps Script web app that appends enquiries to the SKEI admissions sheet — the
# same /exec endpoint the older SKEI site posts to. Must be the deployed web app
# URL ending in /exec (not a deployment ID, not a /dev URL), and the deployment
# must be shared with "Anyone". Leave blank to skip the mirror; enquiries are
# still saved to the database either way.
GOOGLE_SHEETS_WEBAPP_URL=

# ── SKEI Portal (/skei-portal) ──────────────────────────────────────────────
# Session signing secret (server-only). Generate: node scripts/hash-password.mjs --secret
AUTH_SECRET=
